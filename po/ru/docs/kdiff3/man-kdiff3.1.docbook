>22 февраля 2019 г.</date>
<releaseinfo
>kdiff3 1.8</releaseinfo>
</refentryinfo>

<refmeta>
<refentrytitle
><command
>kdiff3</command
></refentrytitle>
<manvolnum
>1</manvolnum>
</refmeta>

<refnamediv>
<refname
><command
>kdiff3</command
></refname>
<refpurpose
>Инструмент для сравнения и объединения файлов и папок</refpurpose>
</refnamediv>

<refsynopsisdiv>
<cmdsynopsis
><command
>kdiff3</command
> <arg choice="opt"
><option
>-u, --ignore</option
></arg
> <arg choice="opt"
><option
>--query</option
></arg
> <arg choice="opt"
><option
>--html</option
></arg
> <arg choice="opt"
><option
>--abort</option
></arg
> <arg choice="opt"
><option
>-m, --merge</option
></arg
> <arg choice="opt"
><option
>-b, --base</option
> <replaceable
>файл</replaceable
></arg
> <arg choice="opt"
><option
>-o, --output</option
> <replaceable
>файл</replaceable
></arg
> <arg choice="opt"
><option
>--out</option
> <replaceable
>файл</replaceable
></arg
> <arg choice="opt"
><option
>--noauto</option
></arg
> <arg choice="opt"
><option
>--auto</option
></arg
> <arg choice="opt"
><option
>--L1</option
> <replaceable
>псевдоним1</replaceable
></arg
> <arg choice="opt"
><option
>--L2</option
> <replaceable
>псевдоним2</replaceable
></arg
> <arg choice="opt"
><option
>--L3</option
> <replaceable
>псевдоним3</replaceable
></arg
